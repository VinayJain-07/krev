# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/tmp/
/.venv-report/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
*.key
git-crypt.key

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Local generated artifacts
/output/
/outputs/
/tmp/
/.codex-tmp/
/.codex-dev-server*.log
.pnpm-store/
__pycache__/
*.pyc
