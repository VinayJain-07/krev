{
  "name": "smark-connect-app",
  "version": "0.1.0",
  "private": true,
  "prisma": {
    "schema": "prisma/schema.prisma"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "prestart": "prisma migrate deploy",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "nodes:validate": "tsx scripts/validate-node-registry.ts",
    "skills:validate": "tsx scripts/validate-node-registry.ts",
    "documents:audit": "tsx scripts/audit-document-system.ts",
    "artifacts:qa": "node --conditions=react-server --import tsx scripts/qa-artifact-orchestrator.ts",
    "report:setup": "python -m venv .venv-report && .venv-report\\Scripts\\python.exe -m pip install -r requirements-report.txt",
    "smoke": "tsx scripts/smoke-app.ts",
    "db:dev": "prisma dev --detach --name smark-connect",
    "db:stop": "prisma dev stop smark-connect",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "6.19.0",
    "bcryptjs": "^3.0.3",
    "border-beam": "^1.3.0",
    "cheerio": "^1.2.0",
    "chrome-launcher": "^1.2.1",
    "docx": "^9.7.1",
    "exceljs": "^4.4.0",
    "framer-motion": "^13.2.0",
    "html-to-image": "^1.11.13",
    "lighthouse": "^13.4.1",
    "lucide-react": "^1.34.0",
    "motion": "^13.2.0",
    "next": "16.3.2",
    "next-auth": "5.0.0-beta.32",
    "officeparser": "7.8.0",
    "pdfkit": "^0.20.1",
    "pptxgenjs": "^4.0.1",
    "puppeteer-core": "25.9.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1",
    "sharp": "0.35.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pdfkit": "^0.17.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.2",
    "prisma": "6.19.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "vitest": "^4.1.11"
  },
  "packageManager": "pnpm@11.19.0"
}
